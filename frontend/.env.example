# Local development: copy this file to frontend/.env.local
# Vite only exposes variables whose names start with VITE_.

VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production (Vercel): do NOT put the production value in this file.
# Set it in the Vercel dashboard under
#   Settings → Environment Variables → VITE_API_BASE_URL
# to your Render URL, with /api and no trailing slash, e.g.
#   https://mini-ecommerce-api-alnq.onrender.com/api
#
# Vite inlines these at BUILD time, not at run time, so changing the value
# in Vercel requires a redeploy before it takes effect.
