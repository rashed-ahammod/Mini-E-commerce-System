# Local development: copy this file to backend/.env
# Production (Render): set these in the service's Environment settings
# instead. Never commit the real .env file.

# ---- Django core ---------------------------------------------------------

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# The app refuses to start with this development default when DEBUG is off.
# On Render the Blueprint generates it for you.
DJANGO_SECRET_KEY=dev-insecure-key-change-me

# True locally, False on Render.
DJANGO_DEBUG=True

# Comma separated hostnames. On Render the service's own hostname is added
# automatically from RENDER_EXTERNAL_HOSTNAME, so this usually needs no
# change there.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_TIME_ZONE=UTC

# Comma separated, including the scheme. The Render hostname is added
# automatically; add a custom domain here if you attach one, e.g.
#   https://api.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Database ------------------------------------------------------------

# Leave unset locally: the app then uses the SQLite file backend/db.sqlite3.
#
# In production this is the Neon connection string, copied from the Neon
# dashboard (Connect), including ?sslmode=require:
#   postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Prefer the DIRECT string over the pooled one (the pooled host contains
# "-pooler"); see DJANGO_DB_DISABLE_SERVER_SIDE_CURSORS below.
#
# You can point this at Neon locally to test the connection before deploying
# - `python manage.py db_info` reports what you are actually connected to.
# Remove it again afterwards so development writes to SQLite, not to the
# production database.
# DATABASE_URL=

# Seconds to keep a database connection open between requests. Use 0 with
# Neon: it suspends an idle database, so a connection held open between
# requests can be dead by the time it is reused.
DJANGO_DB_CONN_MAX_AGE=600

# Force TLS to the database. Not needed when the connection string already
# ends in ?sslmode=require, as Neon's does.
DJANGO_DB_SSL_REQUIRE=False

# Set to True only when DATABASE_URL is a pooled connection string (a Neon
# "-pooler" host, Supabase port 6543, or PgBouncer). Those run in
# transaction mode, so server-side cursors have no session to live in and
# reads fail without this.
DJANGO_DB_DISABLE_SERVER_SIDE_CURSORS=False

# ---- Frontend access (CORS) ----------------------------------------------

# Origins allowed to call this API from a browser, comma separated and with
# the scheme. In production this is the Vercel URL, e.g.
#   https://mini-ecommerce.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Regexes for Vercel preview deployments, whose URL changes per
# commit. Anchor them and scope them to your own project name — a bare
# .vercel.app pattern would let any site on Vercel call this API. Example:
#   ^https://mini-ecommerce-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# ---- HTTPS (only read when DJANGO_DEBUG is False) ------------------------

# Redirect http:// to https://. Render already serves HTTPS, so leaving this
# on is correct there.
DJANGO_SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds. Starts at one hour; raise it (e.g. 31536000) once
# HTTPS is confirmed working, since browsers cache this and it is awkward to
# undo.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False

# ---- Render build-time helpers (set in the Render dashboard) -------------

# "true" on the first deploy to load the sample catalog, then "false".
# SEED_DATA=false

# Fill all three to have the build create an admin account, since Render's
# Free plan has no shell for `manage.py createsuperuser`.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
