# Copy to backend/.env and adjust. Never commit the real .env file.

# Django core
DJANGO_SECRET_KEY=dev-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Comma separated, only needed when served over HTTPS behind a proxy
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave unset to use the local SQLite file (backend/db.sqlite3).
# Example for production: postgres://user:password@host:5432/dbname
# DATABASE_URL=

# Origins allowed to call the API from a browser (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
